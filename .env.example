# =================================================================
# THERMAL-SHIELD Configuration Environment Variables Example
# Copy this file to '.env' and fill in your actual keys.
# =================================================================

# 1. MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/urban_heat
MONGODB_DB_NAME=urban_heat

# 2. ISRO & Indian Geoportal API Credentials
MOSDAC_API_KEY=your_mosdac_api_key_here
MOSDAC_USER_EMAIL=your_registered_mosdac_email@example.com

BHUVAN_DEVELOPER_TOKEN=your_bhuvan_token_here

# 3. Satellite & Global Geospatial APIs
GOOGLE_EARTH_ENGINE_SERVICE_ACCOUNT=your-gee-service-account@your-project.iam.gserviceaccount.com
GOOGLE_EARTH_ENGINE_PRIVATE_KEY_PATH=credentials/gee-private-key.json

NASA_EARTHDATA_USERNAME=your_nasa_earthdata_username
NASA_EARTHDATA_PASSWORD=your_nasa_earthdata_password

OPENWEATHERMAP_API_KEY=your_openweathermap_api_key_here

# 4. AI Advisor Configuration
GEMINI_API_KEY=your_gemini_api_key_here
AI_SERVER_PORT=8001
GIS_SERVER_URL=http://localhost:8000
